    {%- assign srv_blocks = section.blocks | where: 'type', 'server_status' -%}
    {%- if srv_blocks.size > 0 -%}
      <div class="cff-status-bar">
        <span class="cff-status-label">Live Status</span>
        <div class="cff-status-items">
          {%- for block in srv_blocks -%}
            {%- assign is_on = true -%}
            {%- if block.settings.status == 'offline' or block.settings.status == 'maintenance' -%}
              {%- assign is_on = false -%}
            {%- endif -%}
            <div class="cff-status-item" {{ block.shopify_attributes }}>
              <span class="dot {% if is_on %}on{% else %}off{% endif %}"
                    aria-hidden="true"></span>
              {{ block.settings.server_name }}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="cff-divider">
        <div class="cff-divider-line"></div>
      </div>
    {%- endif -%}
  {%- endif -%}

  <!-- ═══ BOTTOM BAR ═══ -->
  <div class="cff-bottom">
    <div class="cff-bottom-inner">

      <p class="cff-copy">
        &copy; {{ 'now' | date: '%Y' }}
        <a href="{{ routes.root_url }}">
          {{ section.settings.site_name | default: shop.name }}
        </a>
        {{ section.settings.copyright_text | default: '— All rights reserved.' }}
      </p>

      <div class="cff-bottom-links">
        {%- if section.settings.policy_1_label != blank -%}
          <a href="{{ section.settings.policy_1_url | default: '#' }}">
            {{ section.settings.policy_1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.policy_2_label != blank -%}
          <a href="{{ section.settings.policy_2_url | default: '#' }}">
            {{ section.settings.policy_2_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.policy_3_label != blank -%}
          <a href="{{ section.settings.policy_3_url | default: '#' }}">
            {{ section.settings.policy_3_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.policy_4_label != blank -%}
          <a href="{{ section.settings.policy_4_url | default: '#' }}">
            {{ section.settings.policy_4_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.version_text != blank -%}
        <span class="cff-version">{{ section.settings.version_text }}</span>
      {%- endif -%}

    </div>
  </div>

</footer>

<script>
(function () {
'use strict';
var SID = '{{ section.id }}';

function boot() {
  var footer = document.getElementById('cff-' + SID);
  if (!footer) return;

  /* ── SCROLL REVEAL ── */
  var items = footer.querySelectorAll('.cff-reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) {
          en.target.classList.add('in-view');
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.08 });
    items.forEach(function (el) { io.observe(el); });
  } else {
    items.forEach(function (el) { el.classList.add('in-view'); });
  }

  /* ── NEWSLETTER SUBMIT ── */
  var emailInput = footer.querySelector('.cff-email');
  var emailBtn   = footer.querySelector('.cff-email-btn');
  if (emailBtn && emailInput) {
    emailBtn.addEventListener('click', function () {
      var val = emailInput.value.trim();
      if (!val || !val.includes('@')) {
        emailInput.style.borderColor = '#dc0f0f';
        emailInput.focus();
        setTimeout(function () { emailInput.style.borderColor = ''; }, 1800);
        return;
      }
      /* Hook into Shopify customer newsletter here if needed */
      emailInput.value = '';
      emailBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2 7.5L6 11.5L13 4" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      emailBtn.style.background = '#00c853';
      setTimeout(function () {
        emailBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1 7.5H14M14 7.5L9 2.5M14 7.5L9 12.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/></svg>';
        emailBtn.style.background = '';
      }, 3000);
    });

    emailInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') emailBtn.click();
    });
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}
if (window.Shopify && Shopify.designMode) {
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail.sectionId === SID) boot();
  });
}
})();
</script>

