                  stroke="white" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}

    </div>

    <!-- NAV COLUMNS RIGHT -->
    <div class="cff-nav-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_column' -%}
          {%- assign col_i = forloop.index -%}
          {%- assign delay_cls = 'cff-d' | append: col_i | append: '' -%}
          {%- if col_i > 5 -%}{%- assign delay_cls = 'cff-d5' -%}{%- endif -%}

          <div class="cff-nav-col cff-reveal {{ delay_cls }}"
               {{ block.shopify_attributes }}>

            {%- if block.settings.heading != blank -%}
              <h3 class="cff-nav-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            <ul class="cff-nav-links">
              {%- for i in (1..8) -%}
                {%- assign label_key = 'link_' | append: i | append: '_label' -%}
                {%- assign url_key   = 'link_' | append: i | append: '_url'   -%}
                {%- assign badge_key = 'link_' | append: i | append: '_badge' -%}
                {%- assign lbl = block.settings[label_key] -%}
                {%- assign lnk = block.settings[url_key]   -%}
                {%- assign bdg = block.settings[badge_key] -%}
                {%- if lbl != blank -%}
                  <li>
                    <a href="{{ lnk | default: '#' }}">
                      {{ lbl }}
                      {%- if bdg != blank -%}
                        <span class="cff-badge {{ bdg | downcase }}">{{ bdg }}</span>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div><!-- /main -->

  <!-- ═══ DIVIDER ═══ -->
  <div class="cff-divider">
    <div class="cff-divider-line"></div>
